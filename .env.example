TV_DATA_DIR=instance            # db + stored files + (if TV_AUDIT_KEY unset) audit.key
TV_AUDIT_KEY=                   # set a long random value in production; keep it OFF the data disk
TV_SECURE_COOKIES=1             # behind HTTPS
TV_TRUST_PROXY=1                # only if behind exactly one trusted reverse proxy
TV_SEED_PW_ADMIN=               # override demo passwords: TV_SEED_PW_<USERNAME>
